<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tsb_bt_core</name>
  <version>0.1.0</version>
  <description>
    Behavior Tree (BehaviorTree.CPP v4) executor that drives turtlesim using
    commands produced by the tsb_cv_brain vision node. Recruitment challenge boilerplate.
  </description>
  <maintainer email="alexandre.oneill@tecnico.ulisboa.pt">TSB Recruitment</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>behaviortree_cpp</depend>
  <depend>ament_index_cpp</depend>

  <!-- Needed only at runtime by launch/challenge.launch.py -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>turtlesim</exec_depend>
  <exec_depend>tsb_cv_brain</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
