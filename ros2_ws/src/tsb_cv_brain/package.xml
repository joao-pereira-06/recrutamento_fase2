<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tsb_cv_brain</name>
  <version>0.1.0</version>
  <description>
    PyTorch vision node that classifies incoming images into turtle commands
    (LEFT / RIGHT / FORWARD) for the tsb_bt_core Behavior Tree. Recruitment challenge boilerplate.
  </description>
  <maintainer email="alexandre.oneill@tecnico.ulisboa.pt">TSB Recruitment</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- PyTorch is installed with pip (see README.md / requirements.txt),
       it is intentionally not declared here as a rosdep key. -->

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
